{
  "name": "hexo-lite-editor",
  "version": "1.0.5",
  "description": "A quiet, native desktop workspace for Hexo publishing.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:tauri": "node scripts/free-dev-port.mjs && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "readme:assets": "node scripts/capture-readme-assets.mjs",
    "readme:stars": "node scripts/generate-star-history.mjs",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "release:macos": "bash scripts/package-macos.sh",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.2",
    "@lezer/highlight": "^1.2.3",
    "@lucide/svelte": "^1.21.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "dompurify": "^3.2.6",
    "markdown-it": "^14.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "@playwright/test": "^1.54.1",
    "@types/markdown-it": "^14.1.2",
    "jsdom": "^26.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
